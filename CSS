/* General Styles */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

.content {
    padding: 20px;
    height: 1500px; /* To create a scrollable page */
}

/* Navbar Styles */
nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: #333;
    z-index: 1000;
    transition: background-color 0.3s, padding 0.3s;
}

nav ul {
    margin: 0;
    padding: 0;
    list-style-type: none;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 60px;
}

nav ul li {
    margin: 0 20px;
}

nav ul li a {
    text-decoration: none;
    color: white;
    font-size: 18px;
    transition: color 0.3s;
}

/* Hover effect on menu items */
nav ul li a:hover {
    color: #FFD700; /* Change color on hover */
}

/* Style when navbar is scrolled */
.navbar-scrolled {
    background-color: #222; /* Darken the background when scrolled */
    padding: 10px 0; /* Reduce padding */
}

